{
  "name": "ascent-cipher-worlds",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ASCENT: The Cipher Worlds — an adaptive Algebra I mastery game",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "shot": "node tools/critic/shoot.mjs",
    "progress": "node tools/progress.mjs",
    "audit:gates": "node tools/gate-audit.mjs",
    "wave": "node tools/check-all.mjs --wave",
    "check": "node tools/check-all.mjs --self-test && node tools/check-all.mjs",
    "check:i18n": "node tools/check-i18n.mjs --self-test && node tools/check-i18n.mjs",
    "check:prose": "node tools/check-context-ask.mjs --self-test && node tools/check-context-ask.mjs",
    "check:solver": "node tools/check-solver.mjs",
    "check:items": "node tools/validate-items.mjs",
    "check:courses": "node tools/critic/ladder.mjs --self-test && node tools/validate-courses.mjs",
    "check:figures": "node tools/check-figures.mjs --self-test --no-render && node tools/check-figures.mjs",
    "check:lang": "node tools/check-language.mjs --self-test && node tools/check-language.mjs",
    "check:vocab": "node tools/check-vocab.mjs --self-test && node tools/check-vocab.mjs",
    "check:echo": "node tools/check-echo.mjs --self-test && node tools/check-echo.mjs",
    "check:determinate": "node tools/critic/determinate.mjs --self-test && node tools/critic/determinate.mjs",
    "check:scenes": "node tools/scene-audit.mjs --self-test && node tools/scene-audit.mjs",
    "check:marlow": "node tools/narrative/marlow-audit.mjs",
    "check:record": "node tools/check-record.mjs --self-test && node tools/check-record.mjs",
    "check:standards": "node tools/build-standards.mjs --self-test && node tools/build-standards.mjs --check",
    "check:docs": "node tools/check-docs.mjs --self-test && node tools/check-docs.mjs",
    "check:cases": "node tools/check-named-cases.mjs --self-test && node tools/check-named-cases.mjs",
    "check:coverage": "node tools/check-coverage.mjs --self-test && node tools/check-coverage.mjs",
    "check:route": "node tools/route-proof.mjs --self-test",
    "check:reachable": "node tools/critic/reachable.mjs --self-test && node tools/critic/reachable.mjs",
    "check:choices": "node tools/critic/choiceaudit.mjs",
    "check:shape": "node tools/critic/choiceshape.mjs --self-test && node tools/critic/choiceshape.mjs",
    "check:traverse": "tools/critic/rungate.sh tools/critic/traverse.mjs --out shots/traverse --self-test",
    "check:wayfind": "node tools/critic/wayfind.mjs --self-test && node tools/critic/wayfind.mjs --out shots/wayfind",
    "check:traffic": "node tools/critic/_play.mjs --self-test && node tools/critic/traffic.mjs --self-test && tools/critic/rungate.sh tools/critic/traffic.mjs --out shots/traffic --minutes 18",
    "check:answerable": "node tools/critic/answerable.mjs",
    "check:mastery": "node tools/simulate-all.mjs --self-test && node tools/simulate-all.mjs",
    "check:mastery:full": "node tools/simulate-all.mjs --full",
    "check:handed": "node tools/critic/handed.mjs --self-test && node tools/critic/handed.mjs",
    "check:meet": "node tools/critic/meet.mjs --self-test && node tools/critic/meet.mjs",
    "check:scaffold": "node tools/critic/scaffoldhonesty.mjs",
    "check:takeover": "tools/critic/takeover.sh shots/takeover --minutes 15",
    "check:sustain": "node tools/critic/sustain.mjs --self-test && tools/critic/sustain.sh shots/sustain --minutes 15",
    "check:quality": "node tools/critic/qualityloop.mjs",
    "bench": "node tools/critic/bench.mjs",
    "bench:cold": "node tools/critic/bench.mjs --cold-only",
    "check:truncate": "node tools/critic/notruncate.mjs --self-test && node tools/critic/notruncate.mjs",
    "check:shopask": "node tools/critic/shopask.mjs",
    "check:templates": "node tools/critic/templatewalk.mjs",
    "check:layout": "tools/critic/rungate.sh tools/critic/landscape.mjs --out shots/landscape",
    "check:density": "tools/critic/rungate.sh tools/critic/glass.mjs --out shots/glass --self-test",
    "check:progress": "node tools/critic/oneprogress.mjs --self-test && node tools/critic/oneprogress.mjs --out shots/oneprogress",
    "check:transient": "node tools/critic/transient.mjs --self-test && node tools/critic/transient.mjs --out shots/transient",
    "check:lock": "node tools/critic/lockstates.mjs",
    "check:wipe": "node tools/critic/wipegate.mjs --self-test && node tools/critic/wipegate.mjs",
    "check:withdrawn": "node tools/critic/withdrawgate.mjs --self-test && node tools/critic/withdrawgate.mjs",
    "check:escape": "node tools/critic/escapekey.mjs",
    "check:motion": "node tools/critic/_play.mjs --self-test && node tools/critic/motion.mjs --self-test && tools/critic/rungate.sh tools/critic/motion.mjs --out shots/motion --minutes 18",
    "check:motion:rule": "node tools/critic/_play.mjs --self-test && node tools/critic/motion.mjs --self-test",
    "check:compose": "node tools/critic/compose.mjs --self-test && tools/critic/rungate.sh tools/critic/compose.mjs --out shots/compose",
    "check:compose:rule": "node tools/critic/compose.mjs --self-test",
    "check:locklayout": "node tools/critic/nolocklayout.mjs",
    "check:modal": "node tools/critic/modal.mjs --self-test && tools/critic/rungate.sh tools/critic/modal.mjs --out shots/modal --plant",
    "check:touch": "tools/critic/rungate.sh tools/critic/touch.mjs --out shots/touch --self-test",
    "check:reach": "node tools/critic/thumb.mjs --self-test && tools/critic/rungate.sh tools/critic/thumb.mjs --out shots/thumb",
    "check:figures:render": "node tools/check-figures.mjs --self-test && node tools/check-figures.mjs --render",
    "check:traffic:rule": "node tools/critic/_play.mjs --self-test && node tools/critic/traffic.mjs --self-test"
  },
  "dependencies": {
    "katex": "^0.16.11",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "vite": "^5.4.0"
  }
}
