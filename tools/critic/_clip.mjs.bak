/** Reproduce the reported Marlow truncation and name the clipping ancestor. */
import { chromium } from 'playwright';
import { mkdir } from 'node:fs/promises';

const arg = (k, d) => { const i = process.argv.indexOf('--' + k); return i >= 0 ? process.argv[i + 1] : d; };
const URL = arg('url', 'http://127.0.0.1:4611');
await mkdir('shots/_clip', { recursive: true });

const LINES = [
  'No rush. Though I will point out that the sky is on fire, in a slow, dignified, nine-hundred-year sort of way.',
  'That ring is a rift. Walk in and it shows you a statement. Make it true and the hole closes.',
  'Cipher motes: loose lattice, where the ground bled. Run through them. The foundry buys kit with them.',
];

const SCAN = () => {
  const out = [];
  const clipping = (el) => {
    const cs = getComputedStyle(el);
    return /hidden|clip|auto|scroll/.test(cs.overflowY) || /hidden|clip|auto|scroll/.test(cs.overflowX)
      || cs.textOverflow === 'ellipsis' || cs.webkitLineClamp !== 'none';
  };
  const walk = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);
  let n;
  while ((n = walk.nextNode())) {
    const s = n.nodeValue.trim();
    if (s.length < 4) continue;
    const el = n.parentElement;
    if (!el) continue;
    const cs = getComputedStyle(el);
    if (cs.visibility === 'hidden' || cs.display === 'none' || +cs.opacity < 0.02) continue;
    const r = document.createRange(); r.selectNodeContents(n);
    const rects = [...r.getClientRects()].filter((x) => x.width > 0 && x.height > 0);
    if (!rects.length) continue;
    // walk up looking for a clipping box the glyphs escape
    for (let a = el; a && a !== document.body; a = a.parentElement) {
      if (!clipping(a)) continue;
      const b = a.getBoundingClientRect();
      const cs2 = getComputedStyle(a);
      for (const g of rects) {
        const overBottom = g.bottom - b.bottom;
        const overRight = g.right - b.right;
        const overTop = b.top - g.top;
        const overLeft = b.left - g.left;
        const worst = Math.max(overBottom, overRight, overTop, overLeft);
        if (worst > 1.5) {
          out.push({
            text: s.slice(0, 70), node: el.className || el.tagName,
            clipper: (a.className || a.tagName) + '', overflow: cs2.overflowY + '/' + cs2.overflowX,
            by: +worst.toFixed(1),
            scroll: a.scrollHeight + 'x' + a.clientHeight,
          });
          break;
        }
      }
      break;
    }
    // an element whose own content does not fit it
    if (el.scrollHeight > el.clientHeight + 2 && /hidden|clip/.test(cs.overflowY))
      out.push({ text: s.slice(0, 70), node: el.className || el.tagName, clipper: 'self', overflow: cs.overflowY, by: el.scrollHeight - el.clientHeight });
  }
  return out;
};

const browser = await chromium.launch({ args: ['--use-gl=angle', '--ignore-gpu-blocklist'] });
for (const [name, w, h, touch] of [['desktop', 1600, 900, false], ['phone-landscape', 844, 390, true], ['phone-portrait', 390, 844, true]]) {
  const ctx = await browser.newContext({
    viewport: { width: w, height: h }, deviceScaleFactor: 2,
    hasTouch: touch, isMobile: touch,
  });
  const page = await ctx.newPage();
  await page.goto(URL, { waitUntil: 'networkidle' });
  await page.evaluate(() => { try { localStorage.clear(); } catch {} });
  await page.reload({ waitUntil: 'networkidle' });
  await page.waitForFunction(() => !!window.__ascent, null, { timeout: 30000 });
  await page.waitForTimeout(5000);
  for (const loc of ['en', 'es', 'pl']) {
    await page.evaluate((l) => window.__ascent.setLocale(l), loc);
    await page.waitForTimeout(400);
    for (let i = 0; i < LINES.length; i++) {
      await page.evaluate((tx) => {
        const c = window.__ascent.comms;
        c.queue.length = 0; c.cur = null;
        c.say(tx, { force: true, now: true });
      }, LINES[i]);
      // let the typewriter finish
      await page.waitForTimeout(2600);
      const hits = await page.evaluate(SCAN);
      const marlow = await page.evaluate(() => {
        const t = document.querySelector('.meta-text');
        const c = document.querySelector('.meta-comms');
        if (!t) return null;
        return {
          shown: c.classList.contains('show'),
          text: t.innerText.slice(0, 200),
          tsh: t.scrollHeight, tch: t.clientHeight,
          csh: c.scrollHeight, cch: c.clientHeight,
          trect: t.getBoundingClientRect().toJSON(),
          crect: c.getBoundingClientRect().toJSON(),
        };
      });
      if (hits.length || (marlow && (marlow.tsh > marlow.tch + 2 || marlow.csh > marlow.cch + 2))) {
        console.log(`\n### ${name} ${loc} line${i}`);
        console.log('  marlow:', JSON.stringify(marlow).slice(0, 400));
        hits.slice(0, 6).forEach((x) => console.log('  CLIP', JSON.stringify(x)));
        await page.screenshot({ path: `shots/_clip/${name}-${loc}-${i}.png` });
      }
    }
  }
  await ctx.close();
}
await browser.close();
console.log('\ndone');
